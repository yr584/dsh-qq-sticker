{
  "name": "dsh-qq-sticker",
  "version": "0.2.2",
  "private": false,
  "type": "module",
  "description": "给 DSH 接入的 QQ 机器人加表情包能力：同步账号收藏表情、按情绪检索、以图片消息发送（OneBot v11 / SnowLuma / NapCat 通用），带设置界面。",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "qq",
    "onebot",
    "sticker",
    "表情包"
  ],
  "author": "skbds",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {}
}
